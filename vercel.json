{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/demo.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/demo", "dest": "/api/demo.py" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
